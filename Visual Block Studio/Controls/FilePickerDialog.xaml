<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Visual_Block_Studio.Controls.FilePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio.Controls"
    Title="Select File"
    CornerRadius="12"
    HorizontalAlignment="Stretch">

    <Grid ColumnSpacing="8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR & ADDRESS BAR -->
        <StackPanel 
            Grid.ColumnSpan="2" 
            Orientation="Horizontal" 
            Spacing="8" Padding="0,0,0,12">
            <!-- Navigation Buttons -->
            <Button 
                x:Name="backButton" 
                Content="&#xE0A6;" 
                FontFamily="Segoe Fluent Icons" 
                Click="BackButton_Click" 
                ToolTipService.ToolTip="Back" 
                Background="Transparent" 
                BorderThickness="0" />
            <Button 
                x:Name="upButton" 
                Content="&#xE11C;" 
                FontFamily="Segoe Fluent Icons" 
                Click="UpButton_Click" 
                ToolTipService.ToolTip="Up to parent folder" 
                Background="Transparent"
                BorderThickness="0" />

            <!-- Breadcrumb Address Bar -->
            <BreadcrumbBar 
                x:Name="pathBreadcrumb" 
                ItemClicked="PathBreadcrumb_ItemClicked" 
                VerticalAlignment="Center" 
                Margin="10,0,0,0" />
        </StackPanel>

        <!-- LEFT SIDEBAR (Drives) -->
        <ListView 
            Grid.Row="1" CornerRadius="8"
            x:Name="sidebarListView" 
            SelectionChanged="SidebarListView_SelectionChanged"
            Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}" >
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SidebarItem">
                    <StackPanel 
                        Orientation="Horizontal" 
                        Spacing="10" 
                        Padding="8,4">
                        <FontIcon 
                            Glyph="{x:Bind Icon, Mode=OneWay}" 
                            FontFamily="Segoe Fluent Icons" 
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}" />
                        <TextBlock 
                            Text="{x:Bind Name, Mode=OneWay}" 
                            VerticalAlignment="Center" 
                            FontSize="13" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- MAIN FOLDER CONTENT AREA -->
        <ScrollViewer 
            Grid.Row="1" Grid.Column="1" 
            Padding="5" CornerRadius="8"
            Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
            <GridView 
                x:Name="folderGridView" 
                SelectionMode="Single"
                SelectionChanged="FolderGridView_SelectionChanged"
                DoubleTapped="FolderGridView_DoubleTapped">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileSystemEntry">
                        <StackPanel 
                            Width="89" Height="80" 
                            Padding="8" Spacing="4" 
                            HorizontalAlignment="Center" 
                            Background="Transparent">
                            <FontIcon 
                                Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="34" 
                                FontFamily="Segoe Fluent Icons" 
                                Foreground="{x:Bind IconColor, Mode=OneWay}" 
                                HorizontalAlignment="Center" />
                            <TextBlock 
                                Text="{x:Bind Name, Mode=OneWay}" 
                                MaxLines="2" FontSize="12" 
                                TextAlignment="Center" 
                                TextTrimming="CharacterEllipsis" 
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <StackPanel
            Orientation="Horizontal"
            Spacing="8" Margin="0, 12, 0, 0"
            Grid.Row="2" Grid.ColumnSpan="2">
            <Button 
                x:Name="selectButton"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MinWidth="245" Content="Select" 
                IsEnabled="False"
                Click="OnPrimaryButtonClick" />
            <Button 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MinWidth="245" Content="Cancel" 
                Click="OnCloseButtonClick" />
        </StackPanel>
    </Grid>
</ContentDialog>
