<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Visual_Block_Studio.Views.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio.Views.Dashboard"
    xmlns:models="using:Visual_Block_Studio.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10" Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                PlaceholderText="Search recent"
                QueryIcon="Find" 
                QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                TextChanged="AutoSuggestBox_TextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Recent">
                        <Grid Padding="15" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Symbol="Document" />

                            <TextBlock Text="{x:Bind Name}" Grid.Column="1" />

                            <TextBlock Grid.Column="2" Text="{x:Bind FriendlyDate}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Border 
                Grid.Row="1" CornerRadius="12"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefault}">
                <ListView 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    ItemsSource="{x:Bind ViewModel.Recents, Mode=OneWay}"
                    SelectionChanged="ListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Recent">
                            <Grid Padding="15" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <SymbolIcon Symbol="Document" />

                                <TextBlock Text="{x:Bind Name}" Grid.Column="1" />

                                <TextBlock Grid.Column="2" Text="{x:Bind FriendlyDate}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <StackPanel 
            MaxWidth="400" 
            Grid.Row="1" Grid.Column="1"
            Spacing="12" Padding="10" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">
            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnCreateFileClick">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Create a new file" FontSize="15" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <TeachingTip 
            Grid.Row="2"
            x:Name="errorTeachingTip"
            Title="Failed to open file"
            Subtitle="An issue occurred while processing the files."
            CloseButtonContent="Dismiss"
            PreferredPlacement="Bottom"
            PlacementMargin="20">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xEA39;" 
                    FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </TeachingTip.IconSource>

            <TextBlock x:Name="errorDetailsText" TextWrapping="Wrap" MaxWidth="300"/>
        </TeachingTip>
    </Grid>
</Page>
