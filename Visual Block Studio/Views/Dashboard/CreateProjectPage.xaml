<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Visual_Block_Studio.Views.Dashboard.CreateProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio.Views.Dashboard"
    xmlns:controls="using:Visual_Block_Studio.Controls">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandColorXaml" Color="#007ACC" />
        <SolidColorBrush x:Key="BrandColorCSharp" Color="#00FF00" />
        <SolidColorBrush x:Key="BrandColorWindows" Color="#0078D4" />
        <SolidColorBrush x:Key="BrandColorWinUI" Color="#5C2D91" />
    </Page.Resources>
    
    <Grid Padding="10" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="WinUI Blank App" FontSize="18" />
            <controls:Badge Text="Xaml" Background="{StaticResource BrandColorXaml}" Foreground="White" />
            <controls:Badge Text="Windows" Background="{StaticResource BrandColorWindows}" Foreground="White" />
            <controls:Badge Text="WinUI" Background="{StaticResource BrandColorWinUI}" Foreground="White" />
            <controls:Badge Text="C#" Background="Transparent" Foreground="{StaticResource BrandColorCSharp}" />
        </StackPanel>

        <StackPanel Spacing="10" Grid.Row="1">
            <StackPanel Spacing="5">
                <TextBlock Text="Project name" />
                <TextBox Text="{x:Bind ViewModel.Request.ProjectName, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Location" />
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <TextBox Text="{x:Bind ViewModel.Request.FilePath, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="..." Click="OnOpenFilePickerClick"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Solution name" />
                <TextBox Text="{x:Bind ViewModel.Request.FileName, Mode=TwoWay}" />
            </StackPanel>

            <CheckBox 
                Content="Place solution and project in the same directory" 
                IsChecked="{x:Bind ViewModel.Request.PlaceProjInSlnx, Mode=OneWay}" />
            
            <TextBlock Text="Project will be created in 'path'" />
        </StackPanel>

        <Button 
            Grid.Row="2" Content="Create" 
            MinWidth="200"
            HorizontalAlignment="Right"
            Click="OnCreateSolutionClick" />

        <TeachingTip 
            Grid.Row="2"
            x:Name="errorTeachingTip"
            Title="File Create Failed"
            Subtitle="An issue occurred while processing the files."
            CloseButtonContent="Dismiss"
            PreferredPlacement="Bottom"
            PlacementMargin="20">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xEA39;" 
                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </TeachingTip.IconSource>

            <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" MaxWidth="300"/>
        </TeachingTip>
    </Grid>
</Page>
