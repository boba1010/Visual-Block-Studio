<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Visual_Block_Studio.Views.Dashboard.CreateFilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio.Views.Dashboard"
    xmlns:controls="using:Visual_Block_Studio.Views.Controls">

    <Page.Resources>
        <SolidColorBrush x:Key="BrandColorXaml" Color="#007ACC" />
        <SolidColorBrush x:Key="BrandColorWindows" Color="#0078D4" />
        <SolidColorBrush x:Key="BrandColorWinUI" Color="#5C2D91" />
    </Page.Resources>
    
    <Grid Padding="10" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Xaml Designer File" FontSize="18" />
            <controls:Badge Text="Xaml" Background="{StaticResource BrandColorXaml}" Foreground="White" />
            <controls:Badge Text="Windows" Background="{StaticResource BrandColorWindows}" Foreground="White" />
            <controls:Badge Text="WinUI" Background="{StaticResource BrandColorWinUI}" Foreground="White" />
        </StackPanel>

        <TextBox Grid.Row="1" Header="File name" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" TextChanged="FileName_TextChanged" />

        <Button 
            Grid.Row="2" Content="Create" 
            MinWidth="200"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Click="OnCreateFileClick" />

        <TeachingTip 
            Grid.Row="2"
            x:Name="errorTeachingTip"
            Title="File Create Failed"
            Subtitle="An issue occurred while processing the files."
            CloseButtonContent="Dismiss"
            PreferredPlacement="Bottom"
            PlacementMargin="20">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xEA39;" 
                FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </TeachingTip.IconSource>

            <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" MaxWidth="300"/>
        </TeachingTip>
    </Grid>
</Page>
