<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Visual_Block_Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio"
    xmlns:models="using:Visual_Block_Studio.Models"
    xmlns:viewmodels="using:Visual_Block_Studio.ViewModels.Shell"
    Title="Visual Block Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar 
            IsTabStop="False"
            x:Name="titlebar">
            <TitleBar.LeftHeader>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="10" Orientation="Horizontal">
                        <TextBlock Text="VBS" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Margin="20, 0, 0, 0" Width="1" Background="Gray" />
                    </StackPanel>

                    <CommandBar IsTabStop="False" Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                        <AppBarButton IsTabStop="False" Width="80" Icon="Folder" Label="Files" ToolTipService.ToolTip="File actions">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Icon="Save" Text="Save" />
                                    
                                    <MenuFlyoutItem Text="SaveAll">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE792;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    
                                    <MenuFlyoutItem Icon="OpenFile" Text="Open" />
                                    <MenuFlyoutSubItem Icon="Add" Text="Add">
                                        <MenuFlyoutItem Icon="Document" Text="Add a new file"/>
                                    </MenuFlyoutSubItem>

                                    <MenuFlyoutItem Icon="Cancel"  Text="Exit" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <TabView
            Grid.Row="1"
            IsTabStop="False"
            x:Name="editorTabView"
            VerticalAlignment="Stretch"
            IsAddTabButtonVisible="False"
            TabItemsSource="{x:Bind ViewModel.Tabs.OpenTabs, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.Tabs.SelectedTab, Mode=TwoWay}"
            TabCloseRequested="EditorTabView_TabCloseRequested">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="viewmodels:TabViewModel">
                    <TabViewItem IsTabStop="False" Header="{x:Bind TabHeader, Mode=OneWay}">
                        <TabViewItem.Content>
                            <Grid>
                                <Frame IsTabStop="False" Loaded="TabFrame_Loaded" DataContext="{x:Bind}" />
                            </Grid>
                        </TabViewItem.Content>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>


        <TeachingTip 
            Grid.Row="2"
            Grid.ColumnSpan="3"
            x:Name="ErrorTeachingTip"
            IsTabStop="False"
            Title="File Load Failed"
            Subtitle="An issue occurred while processing the block map schema structure."
            CloseButtonContent="Dismiss"
            PreferredPlacement="Bottom"
            PlacementMargin="20">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xEA39;" 
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </TeachingTip.IconSource>

            <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" MaxWidth="300"/>
        </TeachingTip>
    </Grid>
</Window>