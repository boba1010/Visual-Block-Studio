<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Visual_Block_Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Visual_Block_Studio"
    xmlns:models="using:Visual_Block_Studio.Models"
    xmlns:viewmodels="using:Visual_Block_Studio.ViewModels.Shell"
    Title="Visual Block Studio">
    
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TitleBar 
            IsTabStop="False"
            Grid.ColumnSpan="3"
            x:Name="titlebar">
            <TitleBar.LeftHeader>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Padding="10" Orientation="Horizontal">
                        <TextBlock Text="VBS" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Margin="20, 0, 0, 0" Width="1" Background="Gray" />                        
                    </StackPanel>

                    <CommandBar IsTabStop="False" Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
                        <AppBarButton IsTabStop="False" Width="80" Icon="Folder" Label="Files" ToolTipService.ToolTip="File actions">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Icon="Save" Text="Save" />
                                    <MenuFlyoutItem Text="SaveAll">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE792;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Icon="OpenFile" Text="Open" />
                                    <MenuFlyoutSubItem Icon="Add" Text="Add">
                                        <MenuFlyoutItem Icon="Document" Text="Add a new file"/>
                                    </MenuFlyoutSubItem>

                                    <MenuFlyoutItem Text="Close File"/>

                                    <MenuFlyoutItem Text="Close Solution" />

                                    <MenuFlyoutItem Icon="Cancel"  Text="Exit" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton 
                            IsTabStop="False" Width="40"
                            LabelPosition="Collapsed" 
                            Icon="Undo" Label="Undo" 
                            ToolTipService.ToolTip="Undo" />
                        <AppBarButton 
                            IsTabStop="False" Width="40" 
                            LabelPosition="Collapsed" 
                            Icon="Redo" Label="Redo" 
                            ToolTipService.ToolTip="Redo" />

                        <AppBarSeparator />

                        <AppBarButton 
                            IsTabStop="False" Width="90" Label="Debug" 
                            ToolTipService.ToolTip="Select which mode you want to compile your app in">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xEBE8;"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <ToggleMenuFlyoutItem Text="Debug" />
                                    <ToggleMenuFlyoutItem Text="Release"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton 
                            IsTabStop="False" Width="150" 
                            Label="CPU Architecture"
                            ToolTipService.ToolTip="Select the CPU architecture">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xEEA1;"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <ToggleMenuFlyoutItem Text="x64" />
                                    <ToggleMenuFlyoutItem Text="x86" />
                                    <ToggleMenuFlyoutItem Text="arm64" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton 
                            IsTabStop="False" MinWidth="150"
                            Label="Visual blocks studio (Unpackaged)"
                            ToolTipService.ToolTip="Run with debugger attached">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xF5B0;"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <ToggleMenuFlyoutItem Text="Packaged" />
                                    <ToggleMenuFlyoutItem Text="Unpackaged" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton 
                            IsTabStop="False"
                            LabelPosition="Collapsed"
                            Width="40"
                            ToolTipService.ToolTip="Run with debugger attached">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE768;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        

        <NavigationView
            IsTabStop="False"
            ItemInvoked="NavigationView_ItemInvoked"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftMinimal"
            Grid.ColumnSpan="2"
            Grid.Row="2">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem 
                    IsTabStop="False"
                    SelectsOnInvoked="False"
                    IsExpanded="True"
                    MenuItemsSource="{x:Bind ViewModel.Solution.SolutionExplorer.ProjectMenuItems, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE737;"/>
                    </NavigationViewItem.Icon>
                    <TextBlock>
                        <Run Text="Solution" />
                        <Run Text="'" />
                        <Run Text="{x:Bind ViewModel.Solution.SolutionName, Mode=OneWay}" />
                        <Run Text="'" />
                    </TextBlock>
                </NavigationViewItem>
                
                <NavigationViewItem 
                    IsTabStop="False"
                    Content="ToolBox"
                    IsExpanded="True"
                    SelectsOnInvoked="False"
                    MenuItemsSource="{x:Bind ViewModel.ToolBox.ToolBoxExplorer.ToolBoxMenuItems, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            
            <NavigationView 
                IsTabStop="False"
                PaneTitle="Block Properties"
                FlowDirection="RightToLeft"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                PaneDisplayMode="LeftMinimal"
                Grid.Row="2"
                Grid.Column="2">
                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                </NavigationView.Resources>

                <TabView
                    IsTabStop="False"
                    x:Name="editorTabView"
                    VerticalAlignment="Stretch"
                    IsAddTabButtonVisible="False"
                    TabItemsSource="{x:Bind ViewModel.Tabs.OpenTabs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Tabs.SelectedTab, Mode=TwoWay}"
                    TabCloseRequested="EditorTabView_TabCloseRequested">
                    <TabView.TabItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TabViewModel">
                            <TabViewItem IsTabStop="False" Header="{x:Bind TabHeader, Mode=OneWay}">
                                <TabViewItem.Content>
                                    <Grid>
                                        <Frame IsTabStop="False" Loaded="TabFrame_Loaded" DataContext="{x:Bind}" />
                                    </Grid>
                                </TabViewItem.Content>
                            </TabViewItem>
                        </DataTemplate>
                    </TabView.TabItemTemplate>
                </TabView>
            </NavigationView>
        </NavigationView>
        

        <TeachingTip 
            Grid.Row="2"
            Grid.ColumnSpan="3"
            x:Name="ErrorTeachingTip"
            IsTabStop="False"
            Title="File Load Failed"
            Subtitle="An issue occurred while processing the block map schema structure."
            CloseButtonContent="Dismiss"
            PreferredPlacement="Bottom"
            PlacementMargin="20">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xEA39;" 
                        FontFamily="{ThemeResource SymbolThemeFontFamily}" 
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </TeachingTip.IconSource>
            
            <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" MaxWidth="300"/>
        </TeachingTip>
    </Grid>
</Window>
